[Unit]
Description=KlipperTouch touchscreen UI
Documentation=/home/orangepi/KlipperTouch/docs/deployment.md
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/orangepi/KlipperTouch
Environment=QT_QPA_PLATFORM=wayland
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/home/orangepi/KlipperTouch/.venv/bin/klippertouch --config /home/orangepi/printer_data/config/KlipperTouch.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
